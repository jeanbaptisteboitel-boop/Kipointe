# Gabarit des variables d'environnement.
#
#   npm run env:preparer   crée un .env à partir de ce fichier et tire les secrets au hasard
#   npm run env:verifier   contrôle la cohérence de l'ensemble avant déploiement
#
# .env est ignoré par git : aucune valeur réelle ne doit figurer dans ce dépôt.

# ─── Base de données Neon (région EU, ex. eu-central-1) ─────────────────────────
# Chaîne "pooled" (pgbouncer) utilisée par l'application sur Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/kipointe?sslmode=require"
# Chaîne directe (sans -pooler) utilisée pour les migrations (drizzle-kit / npm run db:migrate).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/kipointe?sslmode=require"

# ─── Scaleway Object Storage (bucket région fr-par) ─────────────────────────────
SCALEWAY_ACCESS_KEY_ID="SCWXXXXXXXXXXXXXXXXX"
SCALEWAY_SECRET_ACCESS_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
SCALEWAY_REGION="fr-par"
# Nom global : minuscules, chiffres et tirets. Un point casserait le certificat TLS.
SCALEWAY_BUCKET="kipointe-archives"
SCALEWAY_ENDPOINT="https://s3.fr-par.scw.cloud"
# Durée de rétention Object Lock (mode gouvernance) appliquée aux récaps validés, en années.
# Irréversible : elle ne pourra pas être rallongée sur les objets déjà déposés.
ARCHIVE_RETENTION_YEARS="5"

# ─── Sécurité applicative ───────────────────────────────────────────────────────
# Secrets tirés au hasard par `npm run env:preparer` — ne les saisissez pas à la main.
# Secret utilisé pour signer les sessions (32 octets aléatoires minimum).
SESSION_SECRET="changez-moi-32-octets-aleatoires-minimum"
# Secret des tâches cron Vercel (Vercel l'envoie en `Authorization: Bearer ...`).
# Sans lui, /api/cron/quotidien répond 401 et la purge ne s'exécute jamais.
CRON_SECRET="changez-moi-aussi"
# Durée de conservation des pointages avant purge automatique (jours). 5 ans = 1826.
RETENTION_POINTAGES_JOURS="1826"

# ─── Application ────────────────────────────────────────────────────────────────
# URL publique du service, pour vos notes d'exploitation et les liens remis aux gérants.
# (Aucun code ne la lit aujourd'hui : les pages travaillent en chemins relatifs.)
NEXT_PUBLIC_APP_URL="https://kipointe.vercel.app"
# Version d'APK attendue sur les tablettes (renvoyée par /api/terminal/version).
KIOSQUE_APK_VERSION="1.0.0"

# ─── Facultatif : wrapper Android ───────────────────────────────────────────────
# URL de téléchargement de l'APK, en HTTPS, renvoyée aux tablettes par /api/terminal/version.
#KIOSQUE_APK_URL="https://exemple.fr/kipointe.apk"

# ─── Facultatif : amorçage (npm run db:seed, depuis le poste) ───────────────────
# Restent sur le poste : `scripts/vercel-env-push.sh` ne les envoie pas à Vercel.
#SEED_RAISON_SOCIALE="Ma société"
#SEED_GERANT_EMAIL="gerant@exemple.fr"
#SEED_GERANT_MOT_DE_PASSE="un-mot-de-passe-solide"

# ─── Facultatif : développement local ───────────────────────────────────────────
# Force le driver PostgreSQL (`pg` ou `neon`). Vide, il est déduit de l'hôte.
#DATABASE_DRIVER="pg"
# À 1, `npm run build` n'applique pas les migrations.
#SKIP_MIGRATIONS="0"
