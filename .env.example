# ─── Base de données Neon (région EU, ex. eu-central-1) ─────────────────────────
# Chaîne "pooled" (pgbouncer) utilisée par l'application sur Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/kipointe?sslmode=require"
# Chaîne directe (sans -pooler) utilisée pour les migrations (drizzle-kit / npm run db:migrate).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/kipointe?sslmode=require"

# ─── Scaleway Object Storage (bucket région fr-par) ─────────────────────────────
SCALEWAY_ACCESS_KEY_ID="SCWXXXXXXXXXXXXXXXXX"
SCALEWAY_SECRET_ACCESS_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
SCALEWAY_REGION="fr-par"
SCALEWAY_BUCKET="kipointe-archives"
SCALEWAY_ENDPOINT="https://s3.fr-par.scw.cloud"
# Durée de rétention Object Lock (mode gouvernance) appliquée aux récaps validés, en années.
ARCHIVE_RETENTION_YEARS="5"

# ─── Sécurité applicative ───────────────────────────────────────────────────────
# Secret utilisé pour signer les sessions (32 octets aléatoires, ex. `openssl rand -base64 32`).
SESSION_SECRET="changez-moi-32-octets-aleatoires-minimum"
# Secret des tâches cron Vercel (Vercel l'envoie en `Authorization: Bearer ...`).
CRON_SECRET="changez-moi-aussi"
# Durée de conservation des pointages avant purge automatique (jours). 5 ans = 1826.
RETENTION_POINTAGES_JOURS="1826"

# ─── Application ────────────────────────────────────────────────────────────────
# URL publique (utilisée dans les PDF et les liens d'appairage).
NEXT_PUBLIC_APP_URL="https://kipointe.vercel.app"
# Version d'APK attendue sur les tablettes (renvoyée par /api/terminal/version).
KIOSQUE_APK_VERSION="1.0.0"
